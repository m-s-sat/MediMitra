# --------------------------------------
# Terraform standard .gitignore
# --------------------------------------

# Local .terraform directories
**/.terraform/*
.terraform.lock.hcl

# Terraform state files
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Sensitive variable files
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform plan output
*.plan

# CLI configuration files
.terraformrc
terraform.rc

# Ignore provider binaries (if downloaded locally)
.terraform-provider-*

# Local environment or workspace-specific files
*.backup
*.bak
*.tmp

# IDE & editor settings (optional but recommended)
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Logs
*.log
